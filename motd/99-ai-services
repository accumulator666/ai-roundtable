#!/bin/bash
# AI Services Status - displayed on SSH login

# Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
DIM='\033[2m'
NC='\033[0m'

IP=$(hostname -I | awk '{print $1}')

# Function to check service (HTTP)
check_service() {
    local name="$1"
    local port="$2"
    local desc="$3"
    if curl -s --connect-timeout 1 "http://localhost:$port/" > /dev/null 2>&1 || \
       curl -s --connect-timeout 1 "http://localhost:$port/health" > /dev/null 2>&1 || \
       curl -s --connect-timeout 1 "http://localhost:$port/healthz" > /dev/null 2>&1; then
        printf "  ${GREEN}●${NC} %-22s ${BLUE}:%-5s${NC}  %s\n" "$name" "$port" "$desc"
    else
        printf "  ${RED}●${NC} %-22s ${BLUE}:%-5s${NC}  %s\n" "$name" "$port" "$desc"
    fi
}

# Function to check TCP service (non-HTTP like Redis, PostgreSQL)
check_tcp_service() {
    local name="$1"
    local port="$2"
    local desc="$3"
    if (echo > /dev/tcp/localhost/$port) 2>/dev/null; then
        printf "  ${GREEN}●${NC} %-22s ${BLUE}:%-5s${NC}  %s\n" "$name" "$port" "$desc"
    else
        printf "  ${RED}●${NC} %-22s ${BLUE}:%-5s${NC}  %s\n" "$name" "$port" "$desc"
    fi
}

echo ""
