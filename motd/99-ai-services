#!/bin/bash
# AI Services Status - displayed on SSH login

# Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
NC='\033[0m'

IP=$(hostname -I | awk '{print $1}')

echo ""
echo -e "${BOLD}${CYAN}============================================${NC}"
echo -e "${BOLD}${CYAN}          AI SERVER SERVICES                ${NC}"
echo -e "${BOLD}${CYAN}============================================${NC}"
echo ""

# Function to check service (HTTP)
check_service() {
    local name="$1"
    local port="$2"
    local desc="$3"
    if curl -s --connect-timeout 1 "http://localhost:$port/" > /dev/null 2>&1 || \
       curl -s --connect-timeout 1 "http://localhost:$port/health" > /dev/null 2>&1 || \
       curl -s --connect-timeout 1 "http://localhost:$port/healthz" > /dev/null 2>&1; then
        printf "  ${GREEN}●${NC} %-22s ${BLUE}:%-5s${NC}  %s\n" "$name" "$port" "$desc"
    else
        printf "  ${RED}●${NC} %-22s ${BLUE}:%-5s${NC}  %s\n" "$name" "$port" "$desc"
    fi
}

# Function to check TCP service (non-HTTP like Redis, PostgreSQL)
check_tcp_service() {
    local name="$1"
    local port="$2"
    local desc="$3"
    if (echo > /dev/tcp/localhost/$port) 2>/dev/null; then
        printf "  ${GREEN}●${NC} %-22s ${BLUE}:%-5s${NC}  %s\n" "$name" "$port" "$desc"
    else
        printf "  ${RED}●${NC} %-22s ${BLUE}:%-5s${NC}  %s\n" "$name" "$port" "$desc"
    fi
}

echo -e "${BOLD} AI Mesh (Router & Proxies)${NC}"
echo -e " ${YELLOW}─────────────────────────────────────────${NC}"
check_service "AI Router"        8110  "Auto-routing, fan-out, delegation"
check_service "Claude Proxy"     8100  "Anthropic API"
check_service "ChatGPT Proxy"    8101  "OpenAI API"
check_service "Grok Proxy"       8102  "xAI API"
check_service "Gemini Proxy"     8103  "Google API"
check_service "DeepSeek Proxy"   8105  "DeepSeek API"
check_service "Claude Code"      8104  "Claude Code CLI as API"
check_tcp_service "Redis"        6379  "Message bus"
echo ""

echo -e "${BOLD} AI Stack (Core Services)${NC}"
echo -e " ${YELLOW}─────────────────────────────────────────${NC}"
check_service "Open WebUI"       3000  "Chat interface"
check_service "Ollama"          11434  "Local LLM inference"
check_service "Langflow"         7860  "Visual AI flows"
check_service "SearXNG"          8080  "Search (via VPN)"
check_service "Stable Diffusion" 7861  "Image generation"
check_service "ComfyUI"          8188  "Node-based image gen"
echo ""

echo -e "${BOLD} Automation & Tools${NC}"
echo -e " ${YELLOW}─────────────────────────────────────────${NC}"
check_service "n8n"              5678  "Workflow automation"
check_service "Dockge"           5001  "Docker compose manager"
check_service "Portainer"        9443  "Container management (HTTPS)"
check_service "Vaultwarden"      8222  "Password manager"
check_tcp_service "PostgreSQL"   5432  "Database"
echo ""

echo -e "${BOLD} Quick Access:${NC}"
echo -e "  Router API:  ${CYAN}http://$IP:8110/v1/chat/completions${NC}"
echo -e "  All Models:  ${CYAN}http://$IP:8110/v1/models${NC}"
echo -e "  Health:      ${CYAN}http://$IP:8110/health${NC}"
echo -e "  Open WebUI:  ${CYAN}http://$IP:3000${NC}"
echo -e "  n8n:         ${CYAN}http://$IP:5678${NC}"
echo ""
