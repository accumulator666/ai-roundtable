{
  "name": "Multi-AI Comparison",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-compare",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "ai-compare-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-mesh-router:8000/v1/chat/multi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ models: $json.body.models || ['claude-haiku-4-5', 'grok-3-mini', 'deepseek-chat'], messages: $json.body.messages }) }}",
        "options": {}
      },
      "id": "call-multi",
      "name": "Fan-out to AIs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [690, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Fan-out to AIs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fan-out to AIs": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
